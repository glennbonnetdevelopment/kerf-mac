<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Open, import, save and export files the user picks or drops on the window. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Talk to lasers, CNC routers and cutters over USB serial (/dev/cu.*). -->
	<key>com.apple.security.device.serial</key>
	<true/>
	<key>com.apple.security.device.usb</key>
	<true/>
	<!-- A USB or built-in camera above the laser bed, for camera alignment. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Send cut jobs to cutters set up as printers (CUPS queues). -->
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>
